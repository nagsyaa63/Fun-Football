# Copy this file to .env and fill in your values.
#
# Local dev: leave DATABASE_URL blank — the app uses a built-in PGlite
# database stored under ./data/pgdata (no Postgres install needed).
#
# Production: set DATABASE_URL to your Supabase / Render / Neon connection string.

# Postgres connection string (leave blank for local PGlite dev DB)
DATABASE_URL=

# Admin panel password  (change before deploying!)
ADMIN_PASSWORD=changeme123

# Signs login tokens — keep this stable in production, change before deploying
# Generate a strong secret:  openssl rand -hex 32
SESSION_SECRET=dev-secret-change-me

# Port the server listens on (most hosts set this automatically)
PORT=3000
